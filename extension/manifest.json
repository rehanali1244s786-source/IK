{
  "manifest_version": 3,
  "name": "IK DOWNLOADER Integration",
  "version": "2.6.0",
  "minimum_chrome_version": "102",
  "description": "Video download bar with quality picker, plus IDM-style capture of every browser download for IK DOWNLOADER.",
  "permissions": ["webRequest", "storage", "cookies", "contextMenus", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["panel.html"], "matches": ["<all_urls>"] }
  ],
  "action": { "default_popup": "popup.html", "default_title": "IK DOWNLOADER" }
}
